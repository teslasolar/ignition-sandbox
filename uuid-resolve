#!/usr/bin/env python3
"""
UUID Markdown Resolver - Auto-find markdown files by UUID
Single-char prompts: > run | @ ref | # include
"""
import os
import re
import json
import subprocess
from pathlib import Path
from typing import Dict, Optional

class UUIDResolver:
    def __init__(self, root_dir: str = "."):
        self.root = Path(root_dir)
        self.index: Dict[str, dict] = {}
        self.build_index()

    def build_index(self):
        """Scan all .md files and build UUID→path index"""
        for md_file in self.root.rglob("*.md"):
            if md_file.is_file():
                uuid = self._extract_uuid(md_file)
                if uuid:
                    self.index[uuid] = {
                        "path": str(md_file.relative_to(self.root)),
                        "title": self._extract_title(md_file),
                        "abs_path": str(md_file.absolute())
                    }

    def _extract_uuid(self, file_path: Path) -> Optional[str]:
        """Extract UUID from YAML front matter"""
        try:
            with open(file_path, 'r') as f:
                content = f.read()
                # Match: ---\nuuid: <uuid>\n---
                match = re.search(r'^---\s*\nuuid:\s*([a-f0-9-]+)\s*\n', content, re.MULTILINE)
                return match.group(1) if match else None
        except:
            return None

    def _extract_title(self, file_path: Path) -> str:
        """Extract title from YAML or first H1"""
        try:
            with open(file_path, 'r') as f:
                content = f.read()
                # Try YAML title first
                match = re.search(r'^title:\s*(.+)$', content, re.MULTILINE)
                if match:
                    return match.group(1).strip()
                # Fallback to first H1
                match = re.search(r'^#\s+(.+)$', content, re.MULTILINE)
                return match.group(1).strip() if match else file_path.stem
        except:
            return file_path.stem

    def resolve(self, uuid: str) -> Optional[dict]:
        """UUID → file info"""
        return self.index.get(uuid)

    def get_path(self, uuid: str) -> Optional[str]:
        """UUID → absolute path"""
        info = self.resolve(uuid)
        return info["abs_path"] if info else None

    def read_content(self, uuid: str) -> Optional[str]:
        """UUID → file content"""
        path = self.get_path(uuid)
        if path:
            try:
                with open(path, 'r') as f:
                    return f.read()
            except:
                pass
        return None

    def execute(self, uuid: str, lang: str = "bash") -> str:
        """Execute code from markdown file"""
        content = self.read_content(uuid)
        if not content:
            return f"Error: UUID {uuid} not found"

        # Extract code blocks for lang
        pattern = f'```{lang}\n(.+?)```'
        matches = re.findall(pattern, content, re.DOTALL)

        if not matches:
            return f"Error: No {lang} code blocks found"

        # Run first code block
        code = matches[0]
        try:
            result = subprocess.run(
                [lang, "-c", code] if lang == "bash" else [lang],
                input=code.encode() if lang != "bash" else None,
                capture_output=True,
                text=True,
                timeout=30
            )
            return result.stdout + result.stderr
        except Exception as e:
            return f"Error executing: {str(e)}"

    def process_prompts(self, text: str) -> str:
        """Process single-char prompts in text
        > <uuid> = execute
        @ <uuid> = reference/include content
        # <uuid> = include code only
        """
        lines = []
        for line in text.split('\n'):
            # > execute
            if match := re.match(r'^>\s*([a-f0-9-]+)(?:\s+(\w+))?', line):
                uuid, lang = match.groups()
                lang = lang or "bash"
                output = self.execute(uuid, lang)
                lines.append(f"# Executing {uuid}:")
                lines.append(output)

            # @ reference
            elif match := re.match(r'^@\s*([a-f0-9-]+)', line):
                uuid = match.group(1)
                content = self.read_content(uuid)
                if content:
                    lines.append(f"# Referenced from {uuid}:")
                    lines.append(content)
                else:
                    lines.append(f"# Error: {uuid} not found")

            # # include code
            elif match := re.match(r'^#\s*([a-f0-9-]+)(?:\s+(\w+))?', line):
                uuid, lang = match.groups()
                content = self.read_content(uuid)
                if content:
                    pattern = f'```{lang or "\\w+"}\n(.+?)```'
                    code_blocks = re.findall(pattern, content, re.DOTALL)
                    if code_blocks:
                        lines.append(code_blocks[0])
                    else:
                        lines.append(f"# No code blocks found in {uuid}")
                else:
                    lines.append(f"# Error: {uuid} not found")

            else:
                lines.append(line)

        return '\n'.join(lines)

    def list_all(self):
        """List all indexed files"""
        for uuid, info in self.index.items():
            print(f"{uuid[:8]}... | {info['title'][:40]:40} | {info['path']}")

if __name__ == "__main__":
    import sys

    resolver = UUIDResolver("md-sandbox")

    if len(sys.argv) < 2:
        print("UUID Markdown Resolver")
        print("\nUsage:")
        print("  uuid-resolve list              # List all files")
        print("  uuid-resolve path <uuid>       # Get file path")
        print("  uuid-resolve read <uuid>       # Read content")
        print("  uuid-resolve exec <uuid> [lang] # Execute code")
        print("  uuid-resolve proc <file>       # Process prompts in file")
        print("\nSingle-char prompts:")
        print("  > <uuid> [lang]  - Execute code block")
        print("  @ <uuid>         - Include full content")
        print("  # <uuid> [lang]  - Include code block only")
        sys.exit(0)

    cmd = sys.argv[1]

    if cmd == "list":
        resolver.list_all()

    elif cmd == "path" and len(sys.argv) > 2:
        uuid = sys.argv[2]
        path = resolver.get_path(uuid)
        print(path if path else f"Not found: {uuid}")

    elif cmd == "read" and len(sys.argv) > 2:
        uuid = sys.argv[2]
        content = resolver.read_content(uuid)
        print(content if content else f"Not found: {uuid}")

    elif cmd == "exec" and len(sys.argv) > 2:
        uuid = sys.argv[2]
        lang = sys.argv[3] if len(sys.argv) > 3 else "bash"
        print(resolver.execute(uuid, lang))

    elif cmd == "proc" and len(sys.argv) > 2:
        file_path = sys.argv[2]
        with open(file_path, 'r') as f:
            result = resolver.process_prompts(f.read())
            print(result)

    else:
        print(f"Unknown command: {cmd}")
        sys.exit(1)
