{"name":"VM Sandbox","type":"module","parent":"/","version":"1.2.0",
"description":"Browser-based x86 emulation with bootable images",
"profiles":[
  {"id":"minimal","name":"Minimal Boot","memory":16,"boot":"<50ms","desc":"Banner display"},
  {"id":"shell","name":"Interactive Shell","memory":32,"boot":"<100ms","desc":"Keyboard input","recommended":true},
  {"id":"gateway","name":"Gateway Display","memory":32,"boot":"<100ms","desc":"PLC status"},
  {"id":"floppy","name":"IgnAIte OS","memory":64,"boot":"~2s","desc":"Full FAT12 floppy"}
],
"images":{
  "bios":["seabios/bios.bin","seabios/vgabios.bin"],
