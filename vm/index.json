  "rootfs":["ignaite.img"]
},
"commands":[
  {"label":"Boot Minimal","code":"ImageLoader.buildConfig('minimal')"},
  {"label":"Boot Shell","code":"ImageLoader.buildConfig('shell')"},
  {"label":"Boot Gateway","code":"ImageLoader.buildConfig('gateway')"},
  {"label":"Boot Floppy","code":"ImageLoader.buildConfig('floppy')"},
  {"label":"List Images","code":"ImageLoader.listImages()"},
  {"label":"Cache Stats","code":"ImageLoader.getStats()"}
