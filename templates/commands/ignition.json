{
  "id": "ignition",
  "title": "Ignition Gateway",
  "icon": "server",
  "commands": [
    {
      "label": "Install Ignition",
      "code": "curl -sL https://raw.githubusercontent.com/teslasolar/ignition-sandbox/main/ignition-install.sh | sudo bash",
      "description": "One-line installer for Ignition Gateway"
    },
    {
      "label": "Start Gateway",
      "code": "sudo systemctl start ignition",
      "description": "Start the Ignition service"
    },
    {
      "label": "Stop Gateway",
      "code": "sudo systemctl stop ignition",
      "description": "Stop the Ignition service"
    },
    {
      "label": "Restart Gateway",
      "code": "sudo systemctl restart ignition",
      "description": "Restart the Ignition service"
    },
    {
      "label": "Gateway Status",
      "code": "sudo systemctl status ignition",
      "description": "Check gateway service status"
    },
    {
      "label": "View Logs",
      "code": "tail -f /var/log/ignition/wrapper.log",
      "description": "Follow gateway log output"
    },
    {
      "label": "Gateway Web UI",
      "code": "http://localhost:8088",
      "type": "link",
      "description": "Open gateway configuration page"
    },
    {
      "label": "Backup Gateway",
      "code": "sudo /usr/local/bin/ignition/gwcmd --backup /tmp/gateway-backup.gwbk",
      "description": "Create gateway backup file"
    },
    {
      "label": "Restore Gateway",
      "code": "sudo /usr/local/bin/ignition/gwcmd --restore /tmp/gateway-backup.gwbk",
      "description": "Restore from backup file"
    }
  ]
}
